projection;
strict ( 2 );
use draft;

define behavior for ZRNG_C_BILL_HEADER alias Header
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Resume;
  use action Activate;
  use action Discard;
  use action Prepare;

  use action updateBillingDate;
  use action CopyBillingDoc;

  use association _item { create; with draft; }
}

define behavior for Zrng_C_Bill_Item alias Item
{
  use update;
  use delete;

  use association _header  { with draft; }
}
